{
  "name": "strange-harvest-web",
  "version": "1.0.0",
  "description": "Promotional website for Strange Harvest film",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:css": "node scripts/sync-css.mjs",
    "check:css": "node scripts/sync-css.mjs --check",
    "sitemaps": "node scripts/generate-sitemaps.mjs",
    "predev": "node scripts/sync-css.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-css.mjs && node scripts/generate-sitemaps.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.15"
    },
    "sharp": "^0.35.3"
